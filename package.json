{
  "name": "wagdie-simplified",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "23.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "cd scripts && npx ts-node seed-database.ts",
    "seed:quick": "cd scripts && npx ts-node quick-seed.ts",
    "import:gcs": "npx ts-node --project scripts/tsconfig.json scripts/import-gcs-images.ts",
    "images:localize": "npx ts-node --project scripts/tsconfig.json scripts/point-images-to-local.ts",
    "images:extract-metadata": "npx ts-node --project scripts/tsconfig.json scripts/extract-png-metadata.ts",
    "images:compare-metadata": "npx ts-node --project scripts/tsconfig.json scripts/compare-extracted-metadata.ts",
    "opensea:refresh": "npx ts-node --project scripts/tsconfig.json scripts/refresh-opensea-metadata.ts",
    "assets:collect": "npx ts-node --project scripts/tsconfig.json scripts/collect-character-assets.ts",
    "searing:materialize": "npx ts-node --project scripts/tsconfig.json scripts/materialize-searing-events.ts",
    "lore:seed-base": "npx ts-node --project scripts/tsconfig.json scripts/lore/seed-base-lore.ts",
    "lore:verify-base-parity": "npx ts-node --project scripts/tsconfig.json scripts/lore/verify-base-lore-parity.ts",
    "elizaos:smoke": "npx ts-node --project scripts/tsconfig.json scripts/elizaos-official-smoke.ts",
    "elizaos:smoke:post-restart": "ELIZAOS_SMOKE_PHASE=post-restart npx ts-node --project scripts/tsconfig.json scripts/elizaos-official-smoke.ts",
    "elizaos:db:validate": "npx ts-node --project scripts/tsconfig.json scripts/validate-elizaos-migrations.ts",
    "elizaos:routes:validate": "npx ts-node --project scripts/tsconfig.json scripts/elizaos-route-parity.ts",
    "narrative:harness:test": "jest tests/lib/eliza/location-room-narrative-harness.test.ts --runInBand",
    "narrative:harness:live": "npx ts-node --project scripts/tsconfig.json scripts/location-room-narrative-eval.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@elizaos/api-client": "1.7.2",
    "@google-cloud/storage": "^7.19.0",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.9.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.553.0",
    "next": "^15.0.0",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "siwe": "^2.1.4",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.2.14",
    "pino-pretty": "^13.1.2",
    "postcss": "^8",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
